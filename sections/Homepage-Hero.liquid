{% comment %}
  Hero Gift Guide Section
  All text, images, and links are editable from the Theme Editor.
{% endcomment %}

<div class="hero hero-{{ section.id }}">

  {%- if section.settings.desktop_image != blank -%}
    <img
      class="desktop"
      src="{{ section.settings.desktop_image | image_url: width: 2400 }}"
      srcset="
        {{ section.settings.desktop_image | image_url: width: 1200 }} 1200w,
        {{ section.settings.desktop_image | image_url: width: 1800 }} 1800w,
        {{ section.settings.desktop_image | image_url: width: 2400 }} 2400w
      "
      sizes="100vw"
      alt="{{ section.settings.desktop_image.alt | default: section.settings.heading | escape }}"
      width="{{ section.settings.desktop_image.width }}"
      height="{{ section.settings.desktop_image.height }}"
      loading="eager"
    >
  {%- else -%}
    <img class="desktop" src="{{ 'HeroImage.png' | asset_url }}" alt="Hero image">
  {%- endif -%}

  {%- if section.settings.mobile_image != blank -%}
    <img
      class="mobile"
      src="{{ section.settings.mobile_image | image_url: width: 1200 }}"
      srcset="
        {{ section.settings.mobile_image | image_url: width: 600 }} 600w,
        {{ section.settings.mobile_image | image_url: width: 900 }} 900w,
        {{ section.settings.mobile_image | image_url: width: 1200 }} 1200w
      "
      sizes="100vw"
      alt=""
      width="{{ section.settings.mobile_image.width }}"
      height="{{ section.settings.mobile_image.height }}"
      loading="eager"
    >
  {%- else -%}
    <img class="mobile" src="{{ 'mobileImage.png' | asset_url }}" alt="">
  {%- endif -%}

  <div class="text-container-desktop">
    {%- if section.settings.heading != blank -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="hero-desc">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link | default: '#' }}">
        <p>{{ section.settings.button_label }}</p>
        <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="currentColor" />
        </svg>
      </a>
    {%- endif -%}
  </div>

  <div class="text-container-mobile">
    <div class="wrapper">
      <div class="text-wrapper">
        {%- if section.settings.heading != blank -%}
          <h1>{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.mobile_description != blank -%}
          <div class="hero-desc">{{ section.settings.mobile_description }}</div>
        {%- elsif section.settings.description != blank -%}
          <div class="hero-desc">{{ section.settings.description }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link | default: '#' }}">
          <p>{{ section.settings.button_label }}</p>
          <svg width="68" height="30" viewBox="0 0 68 30" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M2 12.7279L1.96701e-07 12.7279L-1.96701e-07 16.7279L2 16.7279L2 12.7279ZM67.4142 16.1421C68.1953 15.3611 68.1953 14.0947 67.4142 13.3137L54.6863 0.585774C53.9052 -0.195275 52.6389 -0.195275 51.8579 0.585774C51.0768 1.36682 51.0768 2.63315 51.8579 3.4142L63.1716 14.7279L51.8579 26.0416C51.0768 26.8227 51.0768 28.089 51.8579 28.87C52.6389 29.6511 53.9052 29.6511 54.6863 28.87L67.4142 16.1421ZM2 16.7279L66 16.7279L66 12.7279L2 12.7279L2 16.7279Z" fill="currentColor" />
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  .hero-{{ section.id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    height: 92vh;
  }
  .hero-{{ section.id }} .mobile {
    display: none;
  }
  .hero-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-{{ section.id }} .text-container-desktop {
    position: absolute;
    bottom: {{ section.settings.text_bottom_offset }}rem;
    left: {{ section.settings.text_left_offset }}rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }
  .hero-{{ section.id }} .text-container-desktop h1 {
    font-weight: 500;
    font-size: 6.5rem;
    line-height: 100%;
    letter-spacing: 0px;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }
  .hero-{{ section.id }} .text-container-desktop .hero-desc {
    font-weight: 400;
    font-size: 2rem;
    line-height: 140%;
    letter-spacing: 0px;
    color: {{ section.settings.text_color }};
  }
  .hero-{{ section.id }} .text-container-desktop .hero-desc p {
    margin: 0;
  }
  .hero-{{ section.id }} .btn {
    background-color: {{ section.settings.button_bg_color }};
    height: 5rem;
    width: 22rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .hero-{{ section.id }} .btn p {
    color: {{ section.settings.button_text_color }};
    font-size: 16px;
    font-weight: 300;
    margin: 0;
    text-transform: uppercase;
  }
  .hero-{{ section.id }} .btn svg {
    color: {{ section.settings.button_text_color }};
    width: 3rem !important;
  }
  /* .hero-{{ section.id }} .btn:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
  } */
   .hero-{{ section.id }} .btn::after {
        background-color: {{ section.settings.button_hover_bg_color }};
    }
  .hero-{{ section.id }} .btn:hover p,
  .hero-{{ section.id }} .btn:hover svg {
    color: {{ section.settings.button_hover_text_color }};
  }
  
  .hero-{{ section.id }} .text-container-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .hero-{{ section.id }} .text-container-desktop h1 {
      font-size: 5vw;
    }

    .hero-template--21500375662790__homepage_hero_FcqPcT .text-container-desktop .hero-desc p {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 749px) {
    .hero-{{ section.id }} {
      height: 55vh;
      position: relative;
    }
    .hero-{{ section.id }} .desktop {
      display: none;
    }
    .hero-{{ section.id }} .mobile {
      display: block;
    }
    .hero-{{ section.id }} .text-container-desktop {
      display: none;
    }
    .hero-{{ section.id }} .text-container-mobile {
      display: flex;
      position: absolute;
      top: 6vh;
      width: 100%;
      justify-content: center;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: center;
      height: 40vh;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .text-wrapper h1 {
      font-weight: 500;
      font-size: 30px;
      line-height: 100%;
      letter-spacing: 0px;
      text-align: center;
      vertical-align: middle;
      color: {{ section.settings.heading_color }};
      margin: 0;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .text-wrapper .hero-desc {
      font-weight: 300;
      font-size: 16px;
      line-height: 130%;
      letter-spacing: 0px;
      text-align: center;
      margin-top: 3rem;
      color: {{ section.settings.text_color }};
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .hero-desc p {
      margin: 0;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn {
      background-color: {{ section.settings.button_bg_color }};
      height: 5rem;
      width: 22rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      text-decoration: none;
      border: none;
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn p {
      color: {{ section.settings.button_text_color }};
      font-size: 16px;
      margin: 0;
      text-transform: uppercase;
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn svg {
      color: {{ section.settings.button_text_color }};
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn::after {
      background-color: {{ section.settings.button_hover_bg_color }};
    }
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn:hover p,
    .hero-{{ section.id }} .text-container-mobile .wrapper .btn:hover svg {
      color: {{ section.settings.button_hover_text_color }};
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero Gift Guide",
  "tag": "section",
  "class": "hero-gift-guide-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description (desktop)",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>"
    },
    {
      "type": "richtext",
      "id": "mobile_description",
      "label": "Description (mobile)",
      "info": "Optional. If left blank, the desktop description will be used.",
      "default": "<p>Discover Joy: Your Ultimate Holiday Gift Destination.</p>"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button background (hover)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button text color (hover)",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Desktop text position"
    },
    {
      "type": "range",
      "id": "text_bottom_offset",
      "label": "Bottom offset (rem)",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 4
    },
    {
      "type": "range",
      "id": "text_left_offset",
      "label": "Left offset (rem)",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 4.5
    }
  ],
  "presets": [
    {
      "name": "Homepage-Hero"
    }
  ]
}
{% endschema %}
