{%- liquid
  assign box_collection = section.settings.box_collection
  assign box_size = section.settings.box_size
  assign products = blank
  if box_collection
    assign products = box_collection.products
  endif
-%}

<div class="byb" data-byb data-box-size="{{ box_size }}" data-box-name="{{ section.settings.box_name | escape }}">
  <h2 class="byb__title">{{ section.settings.heading | escape }}</h2>
  <p class="byb__sub">{{ section.settings.subheading | escape }}</p>

  {%- if products == blank -%}
    <p class="byb__empty">Select a collection in the theme editor.</p>
  {%- else -%}
    <div class="byb__layout">
      <div class="byb__grid">
        {%- for product in products -%}
          {%- assign has_available = false -%}
          {%- for v in product.variants %}{% if v.available %}{% assign has_available = true %}{% endif %}{% endfor -%}
          <div class="byb__card" data-card data-title="{{ product.title | escape }}" data-image="{{ product.featured_image | image_url: width: 300 }}">
            <div class="byb__img">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="600" height="600">
              {%- endif -%}
            </div>
            <h3 class="byb__name">{{ product.title }}</h3>

            {%- if product.has_only_default_variant -%}
              <input type="hidden" data-variant value="{{ product.selected_or_first_available_variant.id }}" data-vtitle="" data-price="{{ product.price | money }}">
            {%- else -%}
              <select class="byb__select" data-variant aria-label="Choose option for {{ product.title | escape }}">
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-vtitle="{{ variant.title | escape }}" data-price="{{ variant.price | money }}" {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} – sold out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            {%- endif -%}

            <button type="button" class="byb__add" data-add {% unless has_available %}disabled{% endunless %}>
              {% if has_available %}Add to box{% else %}Sold out{% endif %}
            </button>
          </div>
        {%- endfor -%}
      </div>

      <aside class="byb__box" aria-live="polite">
        <h3 class="byb__box-title">{{ section.settings.box_name | escape }}</h3>
        <p class="byb__count"><span data-count>0</span> / {{ box_size }} selected</p>
        <ul class="byb__slots" data-slots></ul>
        <p class="byb__error" data-error hidden></p>
        <button type="button" class="byb__cta" data-cta disabled>
          <span data-cta-label>Add box to cart</span>
        </button>
      </aside>
    </div>
  {%- endif -%}
</div>

{%- style -%}
  .byb { padding: 5rem 5rem 6rem; font-family: "Jost", sans-serif; color: #111; }
  .byb__title { font-family: "Lustria", serif; font-weight: 400; font-size: 3.5rem; margin: 0 0 .75rem; }
  .byb__sub { margin: 0 0 2.5rem; color: #444; font-size: 1.6rem; }
  .byb__layout { display: grid; grid-template-columns: 1fr 340px; gap: 3rem; align-items: start; }
  .byb__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .byb__img { aspect-ratio: 1/1; background: #e9e9e9; overflow: hidden; }
  .byb__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .byb__name { font-weight: 300; font-size: 1.6rem; margin: 1rem 0 .6rem; }
  .byb__select { width: 100%; height: 4rem; border: 1px solid #111; background: #fff; padding: 0 1rem; font-family: inherit; font-size: 1.4rem; margin-bottom: .8rem; }
  .byb__add, .byb__cta { width: 100%; height: 4.4rem; background: #111; color: #fff; border: none; cursor: pointer; text-transform: uppercase; font-family: inherit; font-size: 1.3rem; letter-spacing: .04em; position: relative; overflow: hidden; transition: background-color .3s, color .3s; }
  .byb__add:hover:not([disabled]), .byb__cta:hover:not([disabled]) { background: #FFF544; color: #111; }
  .byb__add[disabled], .byb__cta[disabled] { opacity: .45; cursor: not-allowed; }
  .byb__box { position: sticky; top: 2rem; border: 1px solid #111; padding: 2rem; background: #fff; }
  .byb__box-title { font-family: "Lustria", serif; font-weight: 400; font-size: 2.2rem; margin: 0 0 .4rem; }
  .byb__count { margin: 0 0 1.5rem; font-size: 1.4rem; color: #444; }
  .byb__slots { list-style: none; margin: 0 0 1.5rem; padding: 0; display: grid; gap: .8rem; }
  .byb__slot { display: flex; gap: 1rem; align-items: center; min-height: 6.4rem; border: 1px dashed #aaa; padding: .6rem; font-size: 1.3rem; color: #888; }
  .byb__slot.is-filled { border: 1px solid #111; color: #111; }
  .byb__slot img { width: 5rem; height: 5.2rem; object-fit: cover; flex-shrink: 0; }
  .byb__slot-info { flex: 1; min-width: 0; }
  .byb__slot-info strong { display: block; font-weight: 400; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .byb__slot-info small { color: #666; }
  .byb__remove { background: none; border: none; font-size: 2rem; cursor: pointer; line-height: 1; color: #111; }
  .byb__error { color: #a12626; font-size: 1.3rem; margin: 0 0 1rem; }
  .byb__error[hidden] { display: none; }
  .byb__empty { color: #666; }
  @media (max-width: 900px) {
    .byb { padding: 3rem 1.25rem 3.5rem; }
    .byb__title { font-size: 2.4rem; text-align: center; }
    .byb__sub { text-align: center; font-size: 1.4rem; }
    .byb__layout { grid-template-columns: 1fr; }
    .byb__grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .byb__box { position: sticky; bottom: 0; top: auto; order: -1; padding: 1.2rem; }
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.querySelector('[data-byb]');
    if (!root) return;

    var SIZE = parseInt(root.dataset.boxSize, 10) || 3;
    var BOX_NAME = root.dataset.boxName || 'Your box';
    var slotsEl = root.querySelector('[data-slots]');
    var countEl = root.querySelector('[data-count]');
    var errorEl = root.querySelector('[data-error]');
    var cta = root.querySelector('[data-cta]');
    var ctaLabel = root.querySelector('[data-cta-label]');
    var picks = [];

    function render() {
      slotsEl.innerHTML = '';
      for (var i = 0; i < SIZE; i++) {
        var li = document.createElement('li');
        var p = picks[i];
        if (p) {
          li.className = 'byb__slot is-filled';
          li.innerHTML =
            '<img src="' + p.image + '" alt="">' +
            '<div class="byb__slot-info"><strong></strong><small></small></div>' +
            '<button type="button" class="byb__remove" aria-label="Remove">&times;</button>';
          li.querySelector('strong').textContent = p.title;
          li.querySelector('small').textContent = p.vtitle;
          li.querySelector('button').addEventListener('click', (function (idx) {
            return function () { picks.splice(idx, 1); render(); };
          })(i));
        } else {
          li.className = 'byb__slot';
          li.textContent = 'Slot ' + (i + 1) + ' – empty';
        }
        slotsEl.appendChild(li);
      }
      countEl.textContent = picks.length;
      cta.disabled = picks.length !== SIZE;
      root.querySelectorAll('[data-add]').forEach(function (b) {
        var card = b.closest('[data-card]');
        var sel = card.querySelector('[data-variant]');
        var soldOut = sel && sel.tagName === 'SELECT' && !sel.querySelector('option:not([disabled])');
        b.disabled = picks.length >= SIZE || soldOut;
      });
      errorEl.hidden = true;
    }

    root.querySelectorAll('[data-card]').forEach(function (card) {
      var sel = card.querySelector('[data-variant]');
      // start on the first available variant
      if (sel && sel.tagName === 'SELECT') {
        var first = sel.querySelector('option:not([disabled])');
        if (first) sel.value = first.value;
      }
      card.querySelector('[data-add]').addEventListener('click', function () {
        if (picks.length >= SIZE) return;
        var opt = sel.tagName === 'SELECT' ? sel.options[sel.selectedIndex] : sel;
        picks.push({
          id: parseInt(sel.value, 10),
          title: card.dataset.title,
          image: card.dataset.image,
          vtitle: opt.dataset.vtitle || ''
        });
        render();
      });
    });

    cta.addEventListener('click', function () {
      if (picks.length !== SIZE) return;

      var boxId = 'box-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
      // one line per pick; the shared _box_id property is what groups them in the cart
      var items = picks.map(function (p) {
        return {
          id: p.id,
          quantity: 1,
          properties: { _box_id: boxId, _box_name: BOX_NAME, _box_size: String(SIZE) }
        };
      });

      cta.disabled = true;
      ctaLabel.textContent = 'adding…';

      fetch((window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (res) {
          if (!res.ok) return res.json().then(function (e) { throw e; });
          return res.json();
        })
        .then(function () {
          ctaLabel.textContent = 'added ✓';
          document.dispatchEvent(new CustomEvent('cart:updated'));
          picks = [];
          setTimeout(function () {
            window.location.href = (window.Shopify && Shopify.routes ? Shopify.routes.root : '/') + 'cart';
          }, 600);
        })
        .catch(function (err) {
          errorEl.textContent = (err && err.description) || 'Could not add the box to your cart. Please try again.';
          errorEl.hidden = false;
          ctaLabel.textContent = 'Add box to cart';
          cta.disabled = false;
        });
    });

    render();
  })();
</script>

{% schema %}
{
  "name": "Build your box",
  "tag": "section",
  "class": "build-your-box-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick 3 products and add them to your cart in one click." },
    { "type": "text", "id": "box_name", "label": "Box name (shown in cart)", "default": "Your box" },
    { "type": "collection", "id": "box_collection", "label": "Collection to pick from" },
    { "type": "range", "id": "box_size", "label": "Products per box", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Build your box", "category": "Collection" }]
}
{% endschema %}